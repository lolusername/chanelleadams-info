---
import LegacyHead from "../components/LegacyHead.astro";

const {
  settings,
  navItems = []
} = Astro.props;

type NavItem = {
  label: string;
  path: string;
  hidden?: boolean;
};

const siteTitleUppercase = settings.siteTitle.toUpperCase();

const normalizePath = (path = "/") => {
  const pathOnly = path.split("?")[0].split("#")[0];
  const trimmed = pathOnly.replace(/^\/+|\/+$/g, "");

  if (!trimmed || trimmed === "index.html") {
    return "/";
  }

  return `/${trimmed}`;
};

const equivalentPaths = (path = "/") => {
  const normalized = normalizePath(path);

  if (normalized === "/") {
    return ["/"];
  }

  const withoutHtml = normalized.endsWith(".html")
    ? normalized.slice(0, -".html".length)
    : normalized;

  return [normalized, withoutHtml, `${withoutHtml}.html`];
};

const currentPath = normalizePath(Astro.url.pathname);
const currentPathWithoutHtml =
  currentPath === "/" ? currentPath : currentPath.replace(/\.html$/, "");
const currentLabelByPath: Record<string, string> = {
  "/": "NEWS",
  "/bio": "BIO",
  "/contact": "CONTACT",
  "/cut-paste": "PUBLISHING PROJECTS",
  "/pharmacy": "RESEARCH PRACTICE"
};
const currentLabel = currentLabelByPath[currentPathWithoutHtml];
const normalizeLabel = (label = "") => label.replace(/\s+/g, " ").trim().toUpperCase();
const isCurrentNavItem = (item: NavItem) =>
  equivalentPaths(item.path).includes(currentPath) ||
  (!!currentLabel && normalizeLabel(item.label) === currentLabel);

const visibleNavItems = navItems.filter(
  (item: NavItem) => item.path !== "/cut-paste.html" && item.path !== "cut-paste.html"
);
---

<!DOCTYPE html>
<html>
  <head>
    <LegacyHead title={settings.siteTitle} analyticsId={settings.analyticsId} />
    <slot name="head" />
  </head>
  <body>
    <main class="container-fluid">
      <a href="/">
        <h1 class="main-name" data-period="100" data-type={JSON.stringify([siteTitleUppercase])}>
          <span class="wrap">{siteTitleUppercase}</span>
        </h1>
      </a>

      <hr class="main-hr" />

      <div class="content">
        <nav class="col-md-2 ">
          <ul>
            {visibleNavItems.map((item) => (
              <li class:list={[item.hidden && "hidden", isCurrentNavItem(item) && "current"]}>
                <a href={item.path}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <div class=" col-md-8 col-md-push-2  ">
          <slot />
        </div>
        <div class="clearfix"></div>
      </div>
    </main>

    <script is:inline>
      var TxtType = function (el, toRotate, period) {
        this.toRotate = toRotate;
        this.el = el;
        this.loopNum = 0;
        this.period = parseInt(period, 10) || 2000;
        this.txt = "";
        this.tick();
        this.isDeleting = false;
      };

      TxtType.prototype.tick = function () {
        var i = this.loopNum % this.toRotate.length;
        var fullTxt = this.toRotate[i];

        if (this.isDeleting) {
        } else {
          this.txt = fullTxt.substring(0, this.txt.length + 1);
        }

        this.el.innerHTML = '<span class="wrap">' + this.txt + "</span>";

        var that = this;
        var delta = 200 - Math.random() * 300;

        if (this.isDeleting) {
          delta /= 2;
        }

        if (!this.isDeleting && this.txt === fullTxt) {
          delta = this.period;
          this.isDeleting = true;
        } else if (this.isDeleting && this.txt === "") {
          delta = 500;
        }

        var tOut = setTimeout(function () {
          that.tick();
        }, delta);

        if (this.loopNum > 0) {
          clearTimeout(tOut);
        }
      };

      window.onload = function () {
        var elements = document.getElementsByClassName("typewrite");
        for (var i = 0; i < elements.length; i++) {
          var toRotate = elements[i].getAttribute("data-type");
          var period = elements[i].getAttribute("data-period");
          if (toRotate) {
            new TxtType(elements[i], JSON.parse(toRotate), period);
          }
        }
        var css = document.createElement("style");
        css.type = "text/css";
        css.innerHTML = ".typewrite > .wrap { border-right: 0.08em solid #fff}";
        document.body.appendChild(css);
      };
    </script>
  </body>
</html>
