---
import CvLayout from "../layouts/CvLayout.astro";
import { CV_PAGE_QUERY } from "../lib/queries";
import { client } from "../lib/sanity";

const data = await client.fetch(CV_PAGE_QUERY);
const categories = data.page?.categoryOrder ?? [];
const entriesByCategory = Object.fromEntries(
  categories.map((category: string) => [
    category,
    data.entries.filter((entry: any) => entry.category === category)
  ])
);
---

<CvLayout title={data.page.title}>
  <div id="cv" class="container">
    <div class="row">
      <div class="col-12 card w-100 mt-md-5 mb-0 mb-md-5">
        <section id="cv-header" class="card-header px-3 pt-3">
          <h5 class="">{data.page.heading}</h5>

          <a class="text-pink-800" href={`mailto:${data.page.contactEmail}`}>{data.page.contactEmail}</a>
        </section>

        <div class="card-body d-flex flex-column px-3 mt-5 mt-md-0 pt-5 pt-md-0 space-y-12">
          <div class="space-y-6 pt-6">
            <section class="space-y-12">
              <div class="space-y-6" >
                {categories.map((category: string) => (
                  <div class="space-y-6">
                    <h2 class="text-2xl uppercase">{category}</h2>

                    {entriesByCategory[category].map((row: any) => (
                      <div class="space-y-2">
                        {row.url ? (
                          <a href={row.url} class="text-pink-900 font-bold">{row.title} {row.organization}</a>
                        ) : (
                          <span class="font-bold">{row.title} | {row.organization}</span>
                        )}
                        {row.description && <p>{row.description}</p>}
                        {row.date && <p class="italic">{row.date}</p>}
                      </div>
                    ))}
                  </div>
                ))}
              </div>
            </section>
          </div>
        </div>
      </div>
    </div>
  </div>
</CvLayout>
