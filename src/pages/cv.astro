---
import LegacyLayout from "../layouts/LegacyLayout.astro";
import { CV_PAGE_QUERY, SITE_SETTINGS_QUERY } from "../lib/queries";
import { client } from "../lib/sanity";

const [settings, data] = await Promise.all([
  client.fetch(SITE_SETTINGS_QUERY),
  client.fetch(CV_PAGE_QUERY)
]);
const categories = data.page?.categoryOrder ?? [];
const entriesByCategory = Object.fromEntries(
  categories.map((category: string) => [
    category,
    data.entries.filter((entry: any) => entry.category === category)
  ])
);
---

<LegacyLayout settings={settings} navItems={settings.homeNavItems}>
  <section id="writing" class="cv-page">
    <div id="cv">
      <div class="col-md-12">
        <h2 class="text-center hidden-sm">{data.page.heading}</h2>
      </div>

      <div class="col-md-12 align-center cv-content">
        <p class="close-up-copy cv-contact">
          <a href={`mailto:${data.page.contactEmail}`}>{data.page.contactEmail}</a>
        </p>

        {categories.map((category: string) => (
          <section class="cv-category">
            <h3>{category}</h3>

            {entriesByCategory[category].map((row: any) => (
              <article class="cv-entry">
                <p class="cv-entry-title">
                  {row.url ? (
                    <a href={row.url}>{row.title}</a>
                  ) : (
                    <span>{row.title}</span>
                  )}
                  {row.organization && <span> | {row.organization}</span>}
                </p>
                {row.description && <p class="cv-entry-description">{row.description}</p>}
                {row.date && <p class="cv-entry-date">{row.date}</p>}
              </article>
            ))}
          </section>
        ))}
      </div>

      <p class="pnum hidden">v.</p>
    </div>
  </section>
</LegacyLayout>
