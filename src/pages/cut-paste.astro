---
import LegacyLayout from "../layouts/LegacyLayout.astro";
import { PUBLISHING_PAGE_QUERY, SITE_SETTINGS_QUERY } from "../lib/queries";
import { excerpt, imageUrlFromFigure, pageTitle } from "../lib/seo";
import { client, urlFor } from "../lib/sanity";

const [settings, page] = await Promise.all([
  client.fetch(SITE_SETTINGS_QUERY),
  client.fetch(PUBLISHING_PAGE_QUERY)
]);

const meta = {
  title: pageTitle(settings.siteTitle, page.title),
  description: excerpt(
    page.items
      .map((item: any) => [item.title, item.subtitle].filter(Boolean).join(". "))
      .join(" ")
  ),
  canonicalPath: "/cut-paste.html",
  image: imageUrlFromFigure(page.items.find((item: any) => item.image)?.image)
};
---

<LegacyLayout settings={settings} navItems={settings.publishingNavItems} meta={meta}>
  <section id="writing" class="">
    <div>
      <div class="col-md-12">
        <h2 class="text-center hidden-sm">{page.title}</h2>
      </div>

      <div class="close-up-copy  flex">
        {page.items.map((item: any) => (
          <div class={item.layoutClass}>
            <img class="img-responsive" src={urlFor(item.image).url()} alt={item.image?.alt ?? ""} />
            <h3 class="text-center">
              <a href={item.externalUrl}>{item.title}</a>
            </h3>
            {item.subtitle && <h3 class="text-center text-info"> {item.subtitle}</h3>}
          </div>
        ))}
      </div>
    </div>

    <p class="pnum hidden">iii.</p>
  </section>
</LegacyLayout>
